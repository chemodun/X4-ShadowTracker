<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Shadow_Tracker_Options_Menu" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>
    <cue name="Init" instantiate="false" version="1">
      <actions>
        <set_value name="$debugLevelIndexes" exact="['none', 'debug', 'trace']" />
        <set_value name="$debugChance" exact="0" />
      </actions>
      <cues>
        <cue name="Register_Menu" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled cue="md.Simple_Menu_API.Reloaded" />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'Shadow Tracker Options: Registering Options Menus'" context="false" filter="scripts" chance="$debugChance" />
            <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
              param="table[
                $id      = 'shadow_tracker_options_menu',
                $columns = 12,
                $title   = {1972092415, 1},
                $onOpen  = Shadow_Tracker_Options_Menu,
              ]" />
          </actions>
        </cue>

        <cue name="Shadow_Tracker_Options_Menu" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'Shadow Tracker Options: Opening Shadow Tracker Options Menu'" context="false" filter="scripts" chance="$debugChance" />
            <debug_text
              text="'Shadow Tracker Options: Current options: %s' . [@player.entity.$shadowTracker]"
              context="false" filter="scripts" chance="$debugChance" />
            <set_value name="$debugLevelOptions" exact="[
              table[$text = {1972092415, 90991}, $value = 'none'],
              table[$text = {1972092415, 90992}, $value = 'debug'],
              table[$text = {1972092415, 90993}, $value = 'trace']
            ]" />
            <set_value name="$debugLevelCurrentIndex" exact="$debugLevelIndexes.indexof.{@player.entity.$shadowTracker.$debugLevel}" />
            <do_if value="$debugLevelCurrentIndex == 0">
              <set_value name="$debugLevelCurrentIndex" exact="1" />
            </do_if>

            <run_actions ref="md.Options_Helper.Add_Title_Row">
              <param name="title" value="{1972092415, 90900}" />
            </run_actions>

            <run_actions ref="md.Options_Helper.Add_Dropdown">
              <param name="id" value="'debugLevel'" />
              <param name="options" value="$debugLevelOptions" />
              <param name="currentIndex" value="$debugLevelCurrentIndex" />
              <param name="col" value="1" />
              <param name="textColSpan" value="8" />
              <param name="text" value="{1972092415, 90990}" />
              <param name="dropdownColSpan" value="4" />
              <param name="handle" value="Shadow_Tracker_Handle_Debug_Level" />
            </run_actions>
            <remove_value name="$debugLevelOptions" />
            <remove_value name="$debugLevelCurrentIndex" />
          </actions>
        </cue>

        <cue name="Shadow_Tracker_Handle_Debug_Level" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'Shadow Tracker Options: Debug Level changed to %s' .[event.param.$option.$value]" context="false" filter="scripts" chance="$debugChance" />
            <set_value name="$resultTable" exact="player.entity.$shadowTracker" />
            <include_actions ref="md.Options_Helper.Process_Dropdown_Changed" />
            <remove_value name="$resultTable" />
            <signal_objects object="player.entity" param="'ShadowTracker.DebugLevelChangedSignal'" />
            <raise_lua_event name="'ShadowTracker.ConfigChanged'" />
          </actions>
        </cue>

        <cue name="Shadow_Tracker_On_Checkbox_Change" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'Shadow Tracker Options: CheckBox %s changed to %s' .[event.param.$id, event.param.$checked]" context="false" filter="scripts" chance="$debugChance" />
            <!-- <do_if value="event.param.$id == 'shadow_tracker_optimizeRename'">
              <set_value name="player.entity.$shadowTracker.$optimizeRename" exact="if event.param.$checked then true else false" />
              <raise_lua_event name="'ShadowTracker.ConfigChanged'" />
            </do_if> -->
            <raise_lua_event name="'ShadowTracker.ConfigChanged'" />
          </actions>
        </cue>

        <cue name="Shadow_Tracker_On_Button_Click" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'Shadow Tracker Options: Button %s clicked' . [event.param.$id]" context="false" filter="scripts" chance="$debugChance" />
            <!-- <do_if value="event.param.$id == 'shadow_tracker_assign_on_hidden'">
              <signal_cue_instantly cue="md.Shadow_Tracker.Assign_POI_On_Hidden_Ships" />
            </do_if> -->
          </actions>
        </cue>

      </cues>
    </cue>


  </cues>
</mdscript>