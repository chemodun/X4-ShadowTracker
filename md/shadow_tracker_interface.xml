<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Shadow_Tracker_Interface" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>

    <cue name="Main" version="1">
      <actions>
        <set_value name="$isInitializedAt" exact="null" />
        <set_value name="$debugChance" exact="0" />
      </actions>
      <cues>
        <cue name="On_Reload" instantiate="true" version="1">
          <conditions>
            <check_any>
              <event_cue_signalled cue="md.Interact_Menu_API.Reloaded" />
              <event_ui_triggered screen="'ShadowTracker'" control="'Reloaded'" />
              <event_game_loaded />
            </check_any>
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <do_if value="not $isInitializedAt? or (player.age - $isInitializedAt) gt 10">
              <set_value name="$isInitializedAt" exact="player.age" />
              <reset_cue cue="this" />
            </do_if>
          </actions>
        </cue>


        <cue name="On_Debug_Level_Changed" instantiate="true" version="1">
          <conditions>
            <event_object_signalled object="player.entity" param="'ShadowTracker.DebugLevelChangedSignal'" />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'ShadowTracker Options: Debug Level changed to %s' .[@player.entity.$shadowTracker.$debugLevel]" context="false" filter="scripts" chance="$debugChance" />
          </actions>
        </cue>

        <cue name="Add_Menu_Actions" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
            <check_value value="@player.holomap.isopen or @event.param.$showPlayerInteractions" />
            <check_value value="event.param.$object? and @event.param.$object != null" />
            <check_value value="@event.param.$selectedplayerships.count == null or @event.param.$selectedplayerships.count == 0 or @event.param.$selectedplayerships.count == 1 and @event.param.$showPlayerInteractions == 1" />
            <check_value value="@event.param.$selectedotherobjects.count == null or @event.param.$selectedotherobjects.count == 0 or @event.param.$selectedotherobjects.count == 1 and @event.param.$selectedotherobjects.indexof.{@event.param.$object} gt 0" />
            <check_value value="@event.param.$selectedplayerdeployables.count == null or @event.param.$selectedplayerdeployables.count == 0" />
            <check_value value="@event.param.$object.owner != faction.player" />
            <check_value value="@event.param.$object.isclass.{class.ship}" />
            <check_value value="not @event.param.$object.isclass.{class.ship_xs}" />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'ShadowTracker: Add_Menu_Actions on: %s, installed: %s'.[@event.param.$object, $installedTrackers]" chance="$debugChance" filter="scripts" />
            <set_value name="$object" exact="event.param.$object" />
            <do_if value="$installedTrackers.indexof.{$object} gt 0">
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id             = 'shadow_tracker_disable',
                  $section        = 'order',
                  $text           = {1972092415, 112}.[@$object.name, @$object.idcode],
                  $mouseover      = {1972092415, 112}.[@$object.name, @$object.idcode],
                  $active         = true,
                  $callback       = On_Manage_Tracker,
                ]" />
            </do_if>
            <do_else>
              <set_value name="$trackersAvailable" exact="@player.entity.inventory.{ware.inv_shadow_tracker}.count" />
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id             = 'shadow_tracker_enable',
                  $section        = 'order',
                  $text           = {1972092415, 111}.[@$object.name, @$object.idcode],
                  $mouseover      = if $trackersAvailable gt 0 then {1972092415, 211}.[@$object.name, @$object.idcode, $trackersAvailable] else {1972092415, 119},
                  $active         = $trackersAvailable gt 0,
                  $callback       = On_Manage_Tracker,
                ]" />
            </do_else>
            <remove_value name="$object" />
          </actions>
        </cue>

        <cue name="On_Manage_Tracker" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.Shadow_Tracker.Get_Variables" />
            <debug_text text="'ShadowTracker: On_Manage_Tracker invoked with param: %s'.[event.param]" chance="$debugChance" filter="scripts" />
            <set_value name="$object" exact="event.param.$object" />
            <set_object_forced_radar_visible object="$object" visible="@event.param.$id == 'shadow_tracker_enable'" />
            <do_if value="event.param.$id == 'shadow_tracker_enable'">
              <add_to_group groupname="$installedTrackers" object="$object" />
              <remove_inventory ware="ware.inv_shadow_tracker" exact="1" />
            </do_if>
            <do_else>
              <remove_from_group group="$installedTrackers" object="$object" />
            </do_else>
            <debug_text text="'ShadowTracker: Operation id: %s, object: %s, installed: %s'.[@event.param.$id, $object, $installedTrackers]" chance="$debugChance" filter="scripts" />
            <remove_value name="$object" />
          </actions>
        </cue>

      </cues>
    </cue>


  </cues>
</mdscript>